<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Simple Contact Form</title>
            </head>
            <body>

                <h2>Contact Us</h2>
                    
                        <!-- The action attribute specifies where to send data. Method "POST" secures user data -->
                            <form action="/submit-form-endpoint" method="POST">
                                    
                                            <!-- Name Field -->
                                                    <div>
                                                                <label for="user-name">Full Name:</label><br>
                                                                            <input type="text" id="user-name" name="name" placeholder="John Doe" required>
                                                                                    </div>
                                                                                            <br>

                                                                                                    <!-- Email Field -->
                                                                                                            <div>
                                                                                                                        <label for="user-email">Email Address:</label><br>
                                                                                                                                    <input type="email" id="user-email" name="email" placeholder="name@example.com" required>
                                                                                                                                            </div>
                                                                                                                                                    <br>

                                                                                                                                                            <!-- Message Field -->
                                                                                                                                                                    <div>
                                                                                                                                                                                <label for="user-message">Your Message:</label><br>
                                                                                                                                                                                            <textarea id="user-message" name="message" rows="5" cols="30" placeholder="Type your message here..." required></textarea>
                                                                                                                                                                                                    </div>
                                                                                                                                                                                                            <br>

                                                                                                                                                                                                                    <!-- Submit Button -->
                                                                                                                                                                                                                            <button type="submit">Send Message</button>
                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                        </form>

                                                                                                                                                                                                                                        </body>
                                                                                                                                                                                                                                        </html>
                                                                                                                                                                                                                                        